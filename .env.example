# Copy to .env and fill in. Loaded by prisma7.config.ts (dotenv) and Next.js.

# SQLite for local dev; swap for Postgres in production (see prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Class AI provider (spec §6.6) — unused until src/lib/classai.ts is implemented.
ANTHROPIC_API_KEY=""

# Email notifications (spec §6.7) — unused until src/lib/email.ts is implemented.
EMAIL_FROM="noreply@example.com"
SMTP_URL=""
