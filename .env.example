# Copy to .env.local and fill in. Loaded by Next.js.

# Supabase Auth/profile setup: copy these into .env.local for Next.js.
# Only a publishable key belongs here; never use a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
APP_URL="http://localhost:3000"

# Class AI provider (spec §6.6) — unused until src/lib/classai.ts is implemented.
ANTHROPIC_API_KEY=""

# Email notifications (spec §6.7) — unused until src/lib/email.ts is implemented.
EMAIL_FROM="noreply@example.com"
SMTP_URL=""
