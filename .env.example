# Copy to .env.local and fill in. Loaded by Next.js.

# Supabase Auth/profile setup: copy these into .env.local for Next.js.
# Only a publishable key belongs here; never use a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL="https://zmtwlnmikhxfsbdtbtax.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xVVaAu5IwociclPJlDNzfw_JvI-s61c
APP_URL="http://localhost:3000"

# ClassAI — server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
OPENAI_API_KEY=""
OPENAI_RESPONSE_MODEL="gpt-5.4-mini"
# ffprobe must be installed on the web server and worker.
FFPROBE_PATH="ffprobe"

# Auth email: configure Resend SMTP in the Supabase dashboard, not here.
# See docs/resend-email-setup.md. Keep the Resend API key out of client env vars.
# Email notifications (spec §6.7). Event dispatch is configured separately.
# Server-only Resend API key for test and event notifications. The sender must
# be verified in Resend; never expose this value with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"
SMTP_URL=""
